# OpenTofu working files
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan

# Local values / secrets (commit the *.example files instead)
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example

# Keep .terraform.lock.hcl COMMITTED: it pins provider versions for everyone.

# Edge stack runtime files (live only on the VM)
edge/.env
edge/secrets/
edge/authelia/users_database.yml
edge/authelia/db.sqlite3
edge/authelia/notification.txt
