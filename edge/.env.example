# Copy to .env on the VM (git-ignored). scripts/gen-secrets.sh fills the generated values.
DOMAIN=cpre-tutor.duckdns.org
ACME_EMAIL=you@example.com            # Let's Encrypt expiry notices

# CT 100 on the tailnet:  tailscale ip -4 llm-gw
LLM_GW_TAILSCALE_IP=100.107.202.27

# LiteLLM virtual key for Open WebUI (created on CT 100, see README)
OPENWEBUI_LITELLM_KEY=sk-...

# Generated by scripts/gen-secrets.sh:
# CROWDSEC_BOUNCER_KEY=
# WEBUI_SECRET_KEY=
# OWUI_OIDC_SECRET=
