# Copy to users_database.yml on the VM (git-ignored).
# Password hash:  sudo docker run --rm -it authelia/authelia:4.39 authelia crypto hash generate argon2
#                 (it prompts for the password; paste the "Digest: $argon2id$..." value below)
users:
  admin:
    disabled: false
    displayname: 'Admin'
    password: '$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME'
    email: 'you@example.com'
    groups:
      - admins
